# Supabase — https://supabase.com/dashboard/project/myyjjtclthflfgxkgubr/settings/api
VITE_SUPABASE_PROJECT_ID=myyjjtclthflfgxkgubr
VITE_SUPABASE_URL=https://myyjjtclthflfgxkgubr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# RevenueCat (native in-app subscriptions)
VITE_REVENUECAT_IOS_API_KEY=test_mxJvcSoUMFnfohtMEiPrVwcJiVK
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=pro
VITE_REVENUECAT_PRODUCT_MONTHLY=ratioai_pro_monthly
VITE_REVENUECAT_PRODUCT_YEARLY=ratioai_pro_yearly

# Subscription gating (optional)
# VITE_SUBSCRIPTION_BYPASS=true
# VITE_SUBSCRIPTION_REQUIRED_WEB=false

# Public web origin (OAuth bridge + email magic-link fallback + meal AI API)
# VITE_PUBLIC_APP_URL=https://ratioai.vercel.app

# Meal photo analysis uses Vercel serverless `/api/analyze-meal`.
# Set OPENAI_API_KEY in Vercel Project → Settings → Environment Variables
# (same sk-… value you already use in Supabase secrets).

# Use native Google/Apple SDKs instead of in-app browser OAuth (optional)
# Requires iOS Google client ID in Supabase → Google → Client IDs
# VITE_NATIVE_SOCIAL_LOGIN=true

# Meta (Facebook) ads — app-install attribution + App Events (iOS only).
# Leave unset until Info.plist has your real Facebook App ID / Client Token
# (see docs/META_ADS_SETUP.md). Also add this to the Codemagic `ratioai_env` group.
# VITE_META_ADS_ENABLED=true

# TikTok ads — app-install attribution + App Events (iOS only). See docs/AD_PLATFORMS_SETUP.md.
# All three are needed; add them to the Codemagic `ratioai_env` group as well.
# VITE_TIKTOK_ADS_ENABLED=true
# VITE_TIKTOK_APP_ID=          # "TikTok App ID" from TikTok Events Manager
# VITE_TIKTOK_ACCESS_TOKEN=    # App Events SDK access token from TikTok Events Manager
# VITE_TIKTOK_APP_STORE_ID=6787262904   # optional, defaults to the RatioAi App Store id

# Apple Ads (Search Ads) attribution via RevenueCat. No ATT prompt needed.
# VITE_APPLE_ADS_ENABLED=true

# Capacitor live-reload dev only (do not set in production CI)
# CAPACITOR_DEV_SERVER=http://localhost:8080
